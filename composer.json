{
    "name": "crustum/broadcasting",
    "description": "Broadcasting plugin for CakePHP applications",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.1",
        "cakephp/authentication": "*",
        "cakephp/authorization": "*",
        "cakephp/queue": "^2.2",
        "crustum/plugin-manifest": "^1.0",
        "guzzlehttp/psr7": "^2.6",
        "pusher/pusher-php-server": "^7.2",
        "symfony/routing": "^6.0|^7.3",
        "symfony/http-foundation": "^6.0",
        "symfony/config": "^6.0|^7.0"
    },
    "suggest": {
        "ext-hash": "Required to use the Ably and Pusher broadcast drivers.",
        "symfony/http-client": "Required to set the Mercure \"client_options\" configuration value.",
        "symfony/mercure": "Required to use the Mercure broadcast driver (^0.8).",
        "web-token/jwt-library": "Required to use end-to-end encrypted Mercure channels (^4.1)."
    },
    "require-dev": {
        "boundwize/structarmed": "^0.15",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.5.0",
        "ratchet/pawl": "^0.4",
        "react/http": "^1.7",
        "cakephp/cakephp-codesniffer": "^5.0",
        "rector/rector": "^2.5",
        "cakephp/bake": "^3.0",
        "symfony/mercure": "^0.8.0",
        "web-token/jwt-library": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Broadcasting\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\Broadcasting\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "tools/phpstan analyse src/ tests/",
        "psalm": "tools/psalm --show-info=false",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan-tests": "tools/phpstan analyze -c tests/phpstan.neon",
        "stan-baseline": "tools/phpstan --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    }
}
